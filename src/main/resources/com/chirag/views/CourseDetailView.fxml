<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.chirag.controllers.CourseDetailController">
    <VBox spacing="24.0" styleClass="content-area">
        <HBox>
            <Button text="Back to Marketplace" onAction="#goBack" styleClass="dynamic-btn" />
        </HBox>

        <!-- Course Info Card -->
        <VBox styleClass="card-container" spacing="12.0">
            <Label fx:id="titleLabel" styleClass="label-header" />
            <HBox spacing="16.0" alignment="CENTER_LEFT">
                <Label fx:id="instructorLabel" style="-fx-font-size: 13px; -fx-text-fill: #8A8A8A;" />
                <Label fx:id="ratingLabel" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #D4A843;" />
            </HBox>
            <FlowPane fx:id="tagsFlowPane" hgap="6.0" vgap="6.0" />
            <Label fx:id="descriptionLabel" wrapText="true" style="-fx-font-size: 13px; -fx-text-fill: #1B2A4A;" />
            <HBox alignment="CENTER_LEFT" spacing="16.0">
                <Label fx:id="priceLabel" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #27714A;" />
                <Button fx:id="buyButton" text="Purchase" styleClass="button-primary" onAction="#handleBuy" style="-fx-min-width: 160px;" />
                <Label fx:id="statusMsgLabel" style="-fx-text-fill: #27714A; -fx-font-weight: bold;" />
                <Region HBox.hgrow="ALWAYS" />
                <Hyperlink text="Report this course" onAction="#handleReport" style="-fx-text-fill: #C0392B; -fx-font-size: 11px;" />
            </HBox>
        </VBox>

        <!-- Curriculum -->
        <VBox styleClass="card-container" spacing="12.0">
            <Label text="Course Content" styleClass="section-header" />
            <VBox fx:id="lecturesList" spacing="8.0" />
        </VBox>

        <!-- Reviews -->
        <VBox styleClass="card-container" spacing="12.0">
            <Label text="Student Reviews" styleClass="section-header" />
            <VBox fx:id="reviewsList" spacing="8.0" />
        </VBox>
    </VBox>
</ScrollPane>
