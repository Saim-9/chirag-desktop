<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<ScrollPane fitToWidth="true" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.chirag.controllers.CourseCreationController">
    <VBox spacing="20.0" styleClass="content-area">
        <VBox styleClass="card-container" spacing="14.0">
            <Label text="Upload Course" styleClass="label-header" />
            <TextField fx:id="titleField" promptText="Course title" />
            <TextField fx:id="priceField" promptText="Price (e.g. 19.99)" />
            <TextArea fx:id="descriptionField" promptText="Course description" prefRowCount="4" wrapText="true" />
            <TextField fx:id="tagsField" promptText="Tags (comma-separated, e.g. JAVA, UI)" />
        </VBox>

        <VBox styleClass="card-container" spacing="14.0">
            <Label text="Lectures" styleClass="section-header" />
            <Label text="Only Google Drive video links are supported. Upload your video to Drive, set sharing to 'Anyone with the link', then paste the link below." style="-fx-text-fill: #C0392B; -fx-font-size: 11px;" wrapText="true" />
            <VBox fx:id="lectureEntryContainer" spacing="12.0">
                <HBox spacing="8.0">
                    <TextField promptText="Lecture title" HBox.hgrow="ALWAYS" />
                    <TextField promptText="Google Drive link" HBox.hgrow="ALWAYS" />
                </HBox>
            </VBox>
            <Button text="Add Lecture" onAction="#addLectureField" styleClass="dynamic-btn" />
        </VBox>

        <HBox alignment="CENTER_RIGHT" spacing="12.0">
            <Button text="Cancel" onAction="#cancelCreation" styleClass="dynamic-btn" />
            <Button text="Publish Course" onAction="#handlePublish" styleClass="button-primary" style="-fx-min-width: 160px;" />
        </HBox>
    </VBox>
</ScrollPane>
