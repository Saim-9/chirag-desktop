<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<ScrollPane fitToWidth="true" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.chirag.controllers.CourseCreationController">
    <VBox spacing="20.0" styleClass="content-area">
        <VBox styleClass="card-container" spacing="15.0">
            <Label text="Creator Studio - Upload Course" styleClass="label-header" />
            <TextField fx:id="titleField" promptText="Course Title" />
            <TextField fx:id="priceField" promptText="Price (e.g. 19.99)" />
            <TextArea fx:id="descriptionField" promptText="Course Description" prefRowCount="4" wrapText="true" style="-fx-border-color: #E0DCD3; -fx-background-color: transparent;" />
            <TextField fx:id="tagsField" promptText="Tags (comma-separated, e.g. JAVA, UI)" />
        </VBox>
        
        <VBox styleClass="card-container" spacing="15.0">
            <Label text="Lectures" styleClass="section-header" />
            <VBox fx:id="lectureEntryContainer" spacing="15.0">
                <HBox spacing="10.0">
                    <TextField promptText="Lecture Title" HBox.hgrow="ALWAYS" />
                    <TextField promptText="Video Link (Drive)" HBox.hgrow="ALWAYS" />
                </HBox>
            </VBox>
            <Button text="Add Another Lecture" onAction="#addLectureField" styleClass="nav-button" style="-fx-background-color: #E0DCD3; -fx-text-fill: #1B263B; -fx-padding: 5 15;" />
        </VBox>
        
        <HBox alignment="CENTER_RIGHT" spacing="15.0">
            <Button text="Cancel" onAction="#cancelCreation" styleClass="nav-button" style="-fx-text-fill: #1B263B;" />
            <Button text="Publish Course" onAction="#handlePublish" styleClass="button-primary" />
        </HBox>
    </VBox>
</ScrollPane>
