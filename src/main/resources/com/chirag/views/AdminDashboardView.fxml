<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.chirag.controllers.AdminDashboardController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16.0" style="-fx-padding: 14 28; -fx-background-color: #1B2A4A;">
            <Label text="Admin Console" style="-fx-text-fill: #FFFFFF; -fx-font-size: 18px; -fx-font-weight: bold;" />
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Sign Out" onAction="#handleLogout" styleClass="nav-button" style="-fx-text-fill: #A0AAB8; -fx-padding: 6 14;" />
        </HBox>
    </top>
    <center>
        <TabPane fx:id="mainTabPane" tabClosingPolicy="UNAVAILABLE">
            <tabs>
                <!-- Financial Reports -->
                <Tab text="Revenue">
                    <VBox spacing="20.0" styleClass="content-area">
                        <Label text="Platform Revenue" styleClass="label-header" />
                        <Label fx:id="totalRevenueLabel" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #27714A;" />
                        <BarChart fx:id="revenueChart" title="Transaction Volume" legendVisible="false" animated="false">
                            <xAxis><CategoryAxis label="Date" /></xAxis>
                            <yAxis><NumberAxis label="Amount ($)" /></yAxis>
                        </BarChart>
                    </VBox>
                </Tab>

                <!-- Moderation -->
                <Tab text="Moderation">
                    <VBox spacing="16.0" styleClass="content-area">
                        <Label text="Reported Courses" styleClass="label-header" />
                        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
                            <VBox fx:id="reportsContainer" spacing="8.0" />
                        </ScrollPane>
                    </VBox>
                </Tab>

                <!-- Users -->
                <Tab text="Users">
                    <VBox spacing="16.0" styleClass="content-area">
                        <Label text="User Directory" styleClass="label-header" />
                        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
                            <VBox fx:id="usersContainer" spacing="6.0" />
                        </ScrollPane>
                    </VBox>
                </Tab>

                <!-- Create Admin -->
                <Tab text="New Admin">
                    <VBox spacing="20.0" styleClass="content-area" alignment="TOP_CENTER">
                        <Label text="Create Administrator" styleClass="label-header" />
                        <VBox spacing="14.0" maxWidth="380.0" alignment="CENTER" styleClass="card-container">
                            <TextField fx:id="adminNameField" promptText="Full name" />
                            <TextField fx:id="adminEmailField" promptText="Email address" />
                            <PasswordField fx:id="adminPasswordField" promptText="Temporary password" />
                            <Button text="Create Admin" onAction="#handleCreateAdmin" styleClass="button-primary" maxWidth="Infinity" />
                        </VBox>
                    </VBox>
                </Tab>

                <!-- Manage Admins (Super Admin) -->
                <Tab fx:id="manageAdminsTab" text="Manage Admins">
                    <VBox spacing="16.0" styleClass="content-area">
                        <Label text="Administrator Directory" styleClass="label-header" />
                        <Label text="Only the Super Admin can remove other administrators." style="-fx-text-fill: #C0392B; -fx-font-size: 11px;" />
                        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
                            <VBox fx:id="adminsContainer" spacing="6.0" />
                        </ScrollPane>
                    </VBox>
                </Tab>
            </tabs>
        </TabPane>
    </center>
</BorderPane>
