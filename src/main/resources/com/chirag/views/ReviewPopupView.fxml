<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.chirag.controllers.ReviewPopupController" alignment="CENTER" spacing="16.0" prefWidth="420.0" prefHeight="330.0" style="-fx-background-color: #FFFFFF; -fx-padding: 28 32;">
    <Label text="Rate this Course" styleClass="label-header" style="-fx-font-size: 18px;" />
    <Label text="Your feedback helps other learners make informed decisions." style="-fx-text-fill: #8A8A8A; -fx-wrap-text: true; -fx-font-size: 12px;" textAlignment="CENTER" />

    <HBox alignment="CENTER" spacing="10.0">
        <Label text="Rating:" style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #1B2A4A;" />
        <ComboBox fx:id="ratingComboBox" styleClass="solid-combo-box">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="1" />
                    <String fx:value="2" />
                    <String fx:value="3" />
                    <String fx:value="4" />
                    <String fx:value="5" />
                </FXCollections>
            </items>
            <value>
                <String fx:value="5" />
            </value>
        </ComboBox>
    </HBox>

    <TextArea fx:id="reviewTextArea" promptText="Write a review (optional)..." prefHeight="90.0" wrapText="true" />

    <HBox alignment="CENTER" spacing="12.0">
        <Button text="Cancel" onAction="#handleCancel" styleClass="dynamic-btn" prefWidth="120" />
        <Button text="Submit" onAction="#handleSubmit" styleClass="button-primary" prefWidth="120" style="-fx-min-width: 120px; -fx-padding: 10 0;" />
    </HBox>
</VBox>