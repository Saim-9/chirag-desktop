<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<VBox stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.chirag.controllers.ReviewPopupController" alignment="CENTER" spacing="20.0" styleClass="content-area" prefWidth="450.0" prefHeight="350.0" style="-fx-background-color: #FFFFFF;">
    <Label text="Rate this Course" styleClass="label-header" />
    <Label text="Congratulations on finishing the course! Please leave a rating and review." style="-fx-text-fill: #8D99AE; -fx-wrap-text: true;" textAlignment="CENTER" />
    
    <HBox alignment="CENTER" spacing="10.0">
        <Label text="Rating:" style="-fx-font-weight: bold; -fx-font-size: 14px;" />
        <ComboBox fx:id="ratingComboBox" style="-fx-font-size: 14px;">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="1" />
                    <String fx:value="2" />
                    <String fx:value="3" />
                    <String fx:value="4" />
                    <String fx:value="5" />
                </FXCollections>
            </items>
            <value>
                <String fx:value="5" />
            </value>
        </ComboBox>
    </HBox>
    
    <TextArea fx:id="reviewTextArea" promptText="Write an optional review..." prefHeight="100.0" style="-fx-font-size: 14px; -fx-padding: 5;" wrapText="true" />
    
    <HBox alignment="CENTER" spacing="15.0">
        <Button text="Cancel" alignment="CENTER" onAction="#handleCancel" styleClass="nav-button" prefWidth="130" style="-fx-text-fill: #1B263B; -fx-background-color: #E0DCD3; -fx-padding: 8 0;" />
        <Button text="Submit Review" onAction="#handleSubmit" styleClass="button-primary" prefWidth="130" style="-fx-padding: 8 0;" />
    </HBox>
</VBox>
