<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="20" styleClass="card-container" prefWidth="400"
      xmlns:fx="http://javafx.com/fxml" fx:controller="com.chirag.controllers.ForgotPasswordController">
    <Label text="Reset Password" styleClass="label-header"/>
    <Label text="Enter your registered email address to reset your password." style="-fx-text-fill: #8D99AE; -fx-wrap-text: true; -fx-max-width: 300; -fx-text-alignment: center;"/>

    <TextField fx:id="emailField" promptText="Email address" styleClass="text-field" maxWidth="300"/>
    
    <VBox fx:id="resetSection" spacing="10" visible="false" managed="false">
        <Label text="Enter your new password:" style="-fx-text-fill: #1B263B;"/>
        <PasswordField fx:id="newPasswordField" promptText="New password (min 6 chars)" styleClass="password-field" maxWidth="300"/>
        <PasswordField fx:id="confirmPasswordField" promptText="Confirm new password" styleClass="password-field" maxWidth="300"/>
        <Button text="Reset Password" styleClass="button-primary" onAction="#handleReset"/>
    </VBox>
    
    <Button fx:id="verifyBtn" text="Verify Email" styleClass="button-primary" onAction="#handleVerifyEmail"/>
    <Label fx:id="statusLabel" style="-fx-text-fill: #8D99AE;"/>
    <Button text="← Back to Login" styleClass="link-text" onAction="#goToLogin"/>
</VBox>
