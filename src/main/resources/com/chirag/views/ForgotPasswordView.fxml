<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="18" style="-fx-background-color: #F5F0EB; -fx-padding: 40;"
      xmlns:fx="http://javafx.com/fxml" fx:controller="com.chirag.controllers.ForgotPasswordController">
    <VBox alignment="CENTER" spacing="16" styleClass="card-container" maxWidth="400" style="-fx-padding: 36;">
        <Label text="Reset Password" styleClass="label-header" style="-fx-font-size: 20px;"/>
        <Label text="Enter your registered email to reset your password." style="-fx-text-fill: #8A8A8A; -fx-wrap-text: true; -fx-max-width: 300; -fx-text-alignment: center; -fx-font-size: 12px;"/>

        <TextField fx:id="emailField" promptText="Email address" maxWidth="300"/>

        <VBox fx:id="resetSection" spacing="10" visible="false" managed="false">
            <Label text="Enter your new password:" style="-fx-text-fill: #1B2A4A; -fx-font-size: 12px;"/>
            <PasswordField fx:id="newPasswordField" promptText="New password (min 6 chars)" maxWidth="300"/>
            <PasswordField fx:id="confirmPasswordField" promptText="Confirm new password" maxWidth="300"/>
            <Button text="Reset Password" styleClass="button-primary" onAction="#handleReset" style="-fx-min-width: 280px;"/>
        </VBox>

        <Button fx:id="verifyBtn" text="Verify Email" styleClass="button-primary" onAction="#handleVerifyEmail" style="-fx-min-width: 280px;"/>
        <Label fx:id="statusLabel" style="-fx-text-fill: #8A8A8A; -fx-font-size: 12px; -fx-wrap-text: true; -fx-max-width: 300; -fx-text-alignment: center;"/>
        <Hyperlink text="Back to sign in" styleClass="link-text" onAction="#goToLogin"/>
    </VBox>
</VBox>
