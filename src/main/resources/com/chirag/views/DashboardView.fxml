<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>

<BorderPane stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.chirag.controllers.DashboardController">
    <left>
        <VBox styleClass="sidebar" prefWidth="250.0">
            <ImageView fitWidth="150" preserveRatio="true">
                <image>
                    <Image url="@../assets/logo.PNG" />
                </image>
            </ImageView>
            <Region prefHeight="40.0" />
            <Button text="Marketplace" styleClass="nav-button" onAction="#goToMarketplace" />
            <Button text="My Learning" styleClass="nav-button" />
            <Button text="Creator Studio" styleClass="nav-button" onAction="#goToCreatorStudio" />
            <Region VBox.vgrow="ALWAYS" />
            <Button text="Logout" styleClass="nav-button" onAction="#handleLogout" />
        </VBox>
    </left>
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <VBox styleClass="content-area" spacing="30.0">
                <VBox styleClass="card-container">
                    <Label fx:id="welcomeLabel" text="Welcome, User!" styleClass="label-header" />
                    <HBox alignment="CENTER_LEFT" spacing="15.0">
                        <Label fx:id="walletLabel" text="Wallet Balance: $0.00" style="-fx-font-size: 16px; -fx-text-fill: #2D6A4F;" />
                        <Button text="+ Top Up" styleClass="button-primary" style="-fx-padding: 5 10; -fx-font-size: 12px;" onAction="#openWalletPopup" />
                    </HBox>
                </VBox>
                
                <HBox spacing="30.0">
                    <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                        <Label text="My Learning" styleClass="section-header" />
                        <FlowPane fx:id="enrolledCoursesContainer" hgap="20.0" vgap="20.0" />
                    </VBox>
                    <VBox spacing="10.0" prefWidth="300.0" styleClass="card-container">
                        <Label text="Recent Transactions" styleClass="section-header" />
                        <ListView fx:id="transactionsList" prefHeight="200.0" prefWidth="350.0" style="-fx-control-inner-background: transparent; -fx-background-color: transparent; -fx-border-color: #E0DCD3;" />
                    </VBox>
                </HBox>

                <VBox spacing="10.0">
                    <Label text="Creator Studio" styleClass="section-header" />
                    <FlowPane fx:id="uploadedCoursesContainer" hgap="20.0" vgap="20.0" />
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
