<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.chirag.controllers.DashboardController">
    <left>
        <VBox styleClass="sidebar" prefWidth="220.0">
            <ImageView fitWidth="100" preserveRatio="true">
                <image>
                    <Image url="@../assets/logo.PNG" />
                </image>
            </ImageView>
            <Region prefHeight="24.0" />
            <Button text="Marketplace" styleClass="nav-button" onAction="#goToMarketplace" />
            <Button text="My Learning" styleClass="nav-button" />
            <Button text="Creator Studio" styleClass="nav-button" onAction="#goToCreatorStudio" />
            <Button text="Profile" styleClass="nav-button" onAction="#goToProfile" />
            <Region VBox.vgrow="ALWAYS" />
            <Button text="Sign Out" styleClass="nav-button" onAction="#handleLogout" />
        </VBox>
    </left>
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <VBox styleClass="content-area" spacing="24.0">
                <!-- Welcome Header -->
                <VBox styleClass="card-container" spacing="8">
                    <Label fx:id="welcomeLabel" text="Welcome" styleClass="label-header" />
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <Label fx:id="walletLabel" text="Balance: $0.00" style="-fx-font-size: 15px; -fx-text-fill: #27714A; -fx-font-weight: bold;" />
                        <Button text="Top Up" styleClass="dynamic-btn" onAction="#openWalletPopup" />
                    </HBox>
                </VBox>

                <!-- My Learning + Transactions -->
                <HBox spacing="24.0">
                    <VBox spacing="12.0" HBox.hgrow="ALWAYS">
                        <Label text="My Learning" styleClass="section-header" />
                        <FlowPane fx:id="enrolledCoursesContainer" hgap="16.0" vgap="16.0" />
                    </VBox>
                    <VBox spacing="12.0" prefWidth="280.0" styleClass="card-container" style="-fx-padding: 18;">
                        <Label text="Recent Transactions" styleClass="section-header" style="-fx-font-size: 14px;" />
                        <ListView fx:id="transactionsList" prefHeight="180.0" />
                    </VBox>
                </HBox>

                <!-- Creator Studio -->
                <VBox spacing="12.0">
                    <Label text="Creator Studio" styleClass="section-header" />
                    <FlowPane fx:id="uploadedCoursesContainer" hgap="16.0" vgap="16.0" />
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
