<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<ScrollPane fitToWidth="true" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.chirag.controllers.EditCourseController">
    <VBox spacing="20.0" styleClass="content-area">
        <VBox styleClass="card-container" spacing="14.0">
            <Label text="Edit Course" styleClass="label-header" />
            <Label text="Update course details. Lecture content cannot be modified here." style="-fx-text-fill: #8A8A8A; -fx-font-size: 12px;" />

            <Label text="Title" styleClass="section-header" style="-fx-font-size: 13px;" />
            <TextField fx:id="titleField" promptText="Course title" />

            <Label text="Price" styleClass="section-header" style="-fx-font-size: 13px;" />
            <TextField fx:id="priceField" promptText="Price (e.g. 19.99)" />

            <Label text="Description" styleClass="section-header" style="-fx-font-size: 13px;" />
            <TextArea fx:id="descriptionField" promptText="Course description" prefRowCount="5" wrapText="true" />

            <Label text="Tags" styleClass="section-header" style="-fx-font-size: 13px;" />
            <TextField fx:id="tagsField" promptText="Comma-separated tags" />
        </VBox>

        <HBox alignment="CENTER_RIGHT" spacing="12.0">
            <Button text="Cancel" onAction="#handleCancel" styleClass="dynamic-btn" />
            <Button text="Save Changes" onAction="#handleSave" styleClass="button-primary" style="-fx-min-width: 160px;" />
        </HBox>
    </VBox>
</ScrollPane>
