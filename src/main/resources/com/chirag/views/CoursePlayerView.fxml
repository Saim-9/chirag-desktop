<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.media.MediaView?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.chirag.controllers.CoursePlayerController">
    <top>
        <HBox spacing="16.0" alignment="CENTER_LEFT" styleClass="card-container" style="-fx-padding: 14 24; -fx-background-radius: 0;">
            <Button text="Back" onAction="#goBack" styleClass="dynamic-btn" />
            <Label fx:id="courseTitleLabel" styleClass="label-header" style="-fx-font-size: 18px;" />
        </HBox>
    </top>
    <center>
        <VBox style="-fx-background-color: #0D1520;" alignment="CENTER">

            <!-- Video Player -->
            <StackPane fx:id="videoContainer" style="-fx-background-color: #000000;" prefWidth="800" prefHeight="450">
                <MediaView fx:id="mediaView" fitWidth="800" fitHeight="450" preserveRatio="true" />
                <Label fx:id="videoStatusLabel" text="Select a lecture to start"
                       style="-fx-text-fill: #8A8A8A; -fx-font-size: 16px; -fx-font-weight: bold;"
                       alignment="CENTER" />
            </StackPane>

            <!-- Controls -->
            <HBox fx:id="controlsBar" spacing="10" alignment="CENTER" style="-fx-padding: 10 20; -fx-background-color: #111827;">
                <Button fx:id="playPauseBtn" text="Play" onAction="#handlePlayPause"
                        styleClass="video-control-btn" prefWidth="90" />
                <Label fx:id="timeLabel" text="00:00 / 00:00"
                       style="-fx-text-fill: #8A8A8A; -fx-font-size: 12px; -fx-font-family: 'Consolas';" />
                <Slider fx:id="seekSlider" HBox.hgrow="ALWAYS" styleClass="video-slider" />
                <Label text="Vol" style="-fx-text-fill: #8A8A8A; -fx-font-size: 11px;" />
                <Slider fx:id="volumeSlider" prefWidth="80" value="80" max="100" styleClass="video-slider" />
            </HBox>

            <!-- Actions -->
            <VBox alignment="CENTER" style="-fx-padding: 14 0; -fx-background-color: #0D1520;" spacing="10">
                <Button text="Mark as Complete"
                        styleClass="button-gold"
                        onAction="#handleMarkAsComplete"
                        maxWidth="280" prefWidth="280" />
                <Label fx:id="progressLabel"
                       style="-fx-text-fill: #D4A843; -fx-font-weight: bold; -fx-font-size: 13px;"
                       alignment="CENTER" />
            </VBox>
        </VBox>
    </center>
    <right>
        <VBox styleClass="card-container" prefWidth="280" spacing="8.0" style="-fx-background-radius: 0; -fx-border-radius: 0;">
            <Label text="Curriculum" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1B2A4A; -fx-padding: 8 0;" />
            <VBox fx:id="lecturesList" spacing="6.0" />
        </VBox>
    </right>
</BorderPane>
