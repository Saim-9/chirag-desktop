<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.web.WebView?>

<BorderPane stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.chirag.controllers.CoursePlayerController">
    <top>
        <HBox spacing="20.0" alignment="CENTER_LEFT" styleClass="card-container" style="-fx-padding: 15;">
            <Button text="Back to Dashboard" onAction="#goBack" styleClass="nav-button" style="-fx-text-fill: #1B263B; -fx-background-color: #E0DCD3; -fx-padding: 5 15;" />
            <Label fx:id="courseTitleLabel" styleClass="label-header" />
        </HBox>
    </top>
    <center>
        <VBox styleClass="content-area" style="-fx-background-color: #0B0F19;">
            <WebView fx:id="videoEngine" prefWidth="800" prefHeight="450" />
            <HBox alignment="CENTER" style="-fx-padding: 20 0;">
                <Button text="Mark as Complete" styleClass="button-primary" onAction="#handleMarkAsComplete" />
                <Label fx:id="progressLabel" style="-fx-padding: 0 0 0 20; -fx-text-fill: #2D6A4F;" />
            </HBox>
        </VBox>
    </center>
    <right>
        <VBox styleClass="card-container" prefWidth="300" spacing="10.0">
            <Label text="Curriculum" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1B263B; -fx-padding: 10 0;" />
            <VBox fx:id="lecturesList" spacing="10.0" />
        </VBox>
    </right>
</BorderPane>
