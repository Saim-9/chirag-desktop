<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.chirag.controllers.ProfileController">
    <left>
        <VBox styleClass="sidebar" prefWidth="220">
            <Label text="Profile" style="-fx-text-fill: #FFFFFF; -fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Button text="Back to Dashboard" onAction="#goBack" styleClass="nav-button"/>
        </VBox>
    </left>
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <VBox spacing="20" styleClass="content-area">
                <Label text="My Profile" styleClass="label-header"/>

                <!-- Account Info -->
                <VBox spacing="10" styleClass="card-container" style="-fx-padding: 22;">
                    <Label text="Account Information" styleClass="section-header" style="-fx-font-size: 14px;"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Name:" style="-fx-font-weight: bold; -fx-min-width: 90; -fx-text-fill: #1B2A4A;"/>
                        <TextField fx:id="nameField" promptText="Your name" prefWidth="280"/>
                    </HBox>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Email:" style="-fx-font-weight: bold; -fx-min-width: 90; -fx-text-fill: #1B2A4A;"/>
                        <Label fx:id="emailLabel" style="-fx-text-fill: #8A8A8A;"/>
                    </HBox>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Role:" style="-fx-font-weight: bold; -fx-min-width: 90; -fx-text-fill: #1B2A4A;"/>
                        <Label fx:id="roleLabel" style="-fx-text-fill: #1B2A4A; -fx-font-weight: bold;"/>
                    </HBox>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Status:" style="-fx-font-weight: bold; -fx-min-width: 90; -fx-text-fill: #1B2A4A;"/>
                        <Label fx:id="statusLabel"/>
                    </HBox>
                    <Button text="Save Changes" onAction="#handleSaveName" styleClass="button-primary" style="-fx-min-width: 140px;"/>
                </VBox>

                <!-- Change Password -->
                <VBox spacing="10" styleClass="card-container" style="-fx-padding: 22;">
                    <Label text="Change Password" styleClass="section-header" style="-fx-font-size: 14px;"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Current:" style="-fx-font-weight: bold; -fx-min-width: 90; -fx-text-fill: #1B2A4A;"/>
                        <PasswordField fx:id="currentPasswordField" promptText="Current password" prefWidth="280"/>
                    </HBox>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="New:" style="-fx-font-weight: bold; -fx-min-width: 90; -fx-text-fill: #1B2A4A;"/>
                        <PasswordField fx:id="newPasswordField" promptText="New password (min 6 chars)" prefWidth="280"/>
                    </HBox>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Confirm:" style="-fx-font-weight: bold; -fx-min-width: 90; -fx-text-fill: #1B2A4A;"/>
                        <PasswordField fx:id="confirmPasswordField" promptText="Confirm new password" prefWidth="280"/>
                    </HBox>
                    <Button text="Update Password" onAction="#handleChangePassword" styleClass="button-primary" style="-fx-min-width: 140px;"/>
                </VBox>

                <!-- Wallet -->
                <VBox spacing="8" styleClass="card-container" style="-fx-padding: 22;">
                    <Label text="Wallet Balance" styleClass="section-header" style="-fx-font-size: 14px;"/>
                    <Label fx:id="walletLabel" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #27714A;"/>
                </VBox>

                <!-- Transactions -->
                <VBox spacing="8" styleClass="card-container" style="-fx-padding: 22;">
                    <Label text="Transaction History" styleClass="section-header" style="-fx-font-size: 14px;"/>
                    <ListView fx:id="transactionsList" prefHeight="180"/>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
