<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.chirag.controllers.ProfileController">
    <left>
        <VBox styleClass="sidebar" prefWidth="220">
            <Label text="👤 Profile" style="-fx-text-fill: #FAF8F5; -fx-font-size: 20px; -fx-font-weight: bold;"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Button text="← Back to Dashboard" onAction="#goBack" styleClass="nav-button"/>
        </VBox>
    </left>
    <center>
        <ScrollPane fitToWidth="true" styleClass="content-area">
            <VBox spacing="20" style="-fx-padding: 30;">
                <Label text="My Profile" styleClass="section-header"/>

                <!-- Account Info Section -->
                <VBox spacing="10" styleClass="item-card" style="-fx-padding: 20;">
                    <Label text="Account Information" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #1B263B;"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Name:" style="-fx-font-weight: bold; -fx-min-width: 100;"/>
                        <TextField fx:id="nameField" promptText="Your name" prefWidth="300"/>
                    </HBox>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Email:" style="-fx-font-weight: bold; -fx-min-width: 100;"/>
                        <Label fx:id="emailLabel" style="-fx-text-fill: #8D99AE;"/>
                    </HBox>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Role:" style="-fx-font-weight: bold; -fx-min-width: 100;"/>
                        <Label fx:id="roleLabel" style="-fx-text-fill: #2D6A4F; -fx-font-weight: bold;"/>
                    </HBox>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Status:" style="-fx-font-weight: bold; -fx-min-width: 100;"/>
                        <Label fx:id="statusLabel"/>
                    </HBox>
                    <Button text="Save Changes" onAction="#handleSaveName" styleClass="button-primary" style="-fx-min-width: 150;"/>
                </VBox>

                <!-- Change Password Section -->
                <VBox spacing="10" styleClass="item-card" style="-fx-padding: 20;">
                    <Label text="Change Password" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #1B263B;"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Current:" style="-fx-font-weight: bold; -fx-min-width: 100;"/>
                        <PasswordField fx:id="currentPasswordField" promptText="Current password" prefWidth="300"/>
                    </HBox>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="New:" style="-fx-font-weight: bold; -fx-min-width: 100;"/>
                        <PasswordField fx:id="newPasswordField" promptText="New password (min 6 chars)" prefWidth="300"/>
                    </HBox>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Confirm:" style="-fx-font-weight: bold; -fx-min-width: 100;"/>
                        <PasswordField fx:id="confirmPasswordField" promptText="Confirm new password" prefWidth="300"/>
                    </HBox>
                    <Button text="Update Password" onAction="#handleChangePassword" styleClass="button-primary" style="-fx-min-width: 150;"/>
                </VBox>

                <!-- Wallet Section -->
                <VBox spacing="10" styleClass="item-card" style="-fx-padding: 20;">
                    <Label text="Wallet" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #1B263B;"/>
                    <Label fx:id="walletLabel" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2D6A4F;"/>
                </VBox>

                <!-- Transaction History Section -->
                <VBox spacing="10" styleClass="item-card" style="-fx-padding: 20;">
                    <Label text="Recent Transactions" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #1B263B;"/>
                    <ListView fx:id="transactionsList" prefHeight="200"/>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
