<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox stylesheets="@styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.chirag.controllers.WalletPopupController" alignment="CENTER" spacing="20.0" styleClass="content-area" prefWidth="400.0" prefHeight="250.0" style="-fx-background-color: #FFFFFF;">
    <Label text="Top Up Virtual Wallet" styleClass="label-header" />
    <TextField fx:id="amountField" promptText="Enter Amount to Top Up" style="-fx-font-size: 14px; -fx-padding: 10;" />
    <HBox alignment="CENTER" spacing="15.0">
        <Button text="Cancel" onAction="#handleCancel" prefWidth="130" style="-fx-text-fill: #1B263B; -fx-background-color: #E0DCD3; -fx-padding: 8 0; -fx-alignment: CENTER; -fx-background-radius: 6px; -fx-cursor: hand;" />
        <Button text="Confirm Payment" onAction="#handleConfirm" styleClass="button-primary" prefWidth="130" style="-fx-padding: 8 0;" />
    </HBox>
</VBox>
