<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.chirag.controllers.WalletPopupController" alignment="CENTER" spacing="18.0" prefWidth="380.0" prefHeight="230.0" style="-fx-background-color: #FFFFFF; -fx-padding: 28 32;">
    <Label text="Top Up Wallet" styleClass="label-header" style="-fx-font-size: 18px;" />
    <TextField fx:id="amountField" promptText="Enter amount" style="-fx-font-size: 14px;" />
    <HBox alignment="CENTER" spacing="12.0">
        <Button text="Cancel" onAction="#handleCancel" styleClass="dynamic-btn" prefWidth="120" />
        <Button text="Confirm" onAction="#handleConfirm" styleClass="button-primary" prefWidth="120" style="-fx-min-width: 120px; -fx-padding: 10 0;" />
    </HBox>
</VBox>
